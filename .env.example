# Motor Orgánico SaleADS · variables de entorno
# Copia este archivo a .env.local y llena lo que corresponda.
# El arranque falla nombrando la variable que falte (src/lib/env.ts).

# --- Obligatorias -----------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Base -------------------------------------------------------------------
APP_URL=http://localhost:3000
ZONA_HORARIA=America/Bogota
# Cabecera de los seis trabajos programados. Mínimo 16 caracteres.
CRON_SECRET=

# --- Google: hoja de cálculo y descarga de videos de Drive -------------------
# Cuenta de servicio con Sheets API y Drive API habilitadas.
# La hoja Y la carpeta de Drive van compartidas con este correo, en lectura.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# El campo private_key del JSON, con los \n tal como vienen.
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Meta / Instagram -------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- YouTube ----------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Tokens de las cuentas --------------------------------------------------
# El nombre de la variable es lo que se escribe en Ajustes como credential_ref.
# Debe empezar por META_TOKEN_, TIKTOK_TOKEN_ o YOUTUBE_TOKEN_ (src/lib/seguridad.ts).
# META_TOKEN_SALEADS=
# META_TOKEN_SALEADS_PAGE_ID=
# META_TOKEN_JUANADS=
# META_TOKEN_JUANADS_PAGE_ID=
